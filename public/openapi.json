{
  "openapi": "3.1.0",
  "info": {
    "title": "Relate World Developer API",
    "description": "Free, key-less access to Relate World's magazines, bulletins, daily reading targets and Bible reading plans (read-only) plus the public Bible Quiz (playable, rate-limited) and the sports club-join registration (POST only). No auth is required. GET responses are cached (`Cache-Control: public`) and served with open CORS; quiz and club-join POSTs are rate-limited per IP. Errors use a consistent `{ \"error\": \"...\" }` shape. Interactive docs: https://relate-iota.vercel.app/api-docs",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://relate-iota.vercel.app"
    }
  ],
  "security": [],
  "paths": {
    "/api/publications": {
      "get": {
        "summary": "List publications",
        "description": "Published magazines & bulletins, newest first. Content bodies (weeks/blocks) are stripped — use /api/publications/{id} for full content.",
        "operationId": "listPublications",
        "tags": ["Magazines & Bulletins"],
        "parameters": [
          {
            "name": "club",
            "in": "query",
            "required": false,
            "description": "Club slug (e.g. sprout-kids, anchors). Use 'relate' for umbrella issues only.",
            "schema": { "type": "string" }
          },
          {
            "name": "kind",
            "in": "query",
            "required": false,
            "description": "Publication kind.",
            "schema": { "type": "string", "enum": ["magazine", "bulletin"] }
          },
          {
            "name": "series",
            "in": "query",
            "required": false,
            "description": "Series name (Relate, Rooted, Footsteps).",
            "schema": { "type": "string" }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "Results per page, 1–100 (default 100).",
            "schema": { "type": "integer", "minimum": 1, "maximum": 100, "default": 100 }
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "description": "Skip N results for pagination (default 0).",
            "schema": { "type": "integer", "minimum": 0, "default": 0 }
          }
        ],
        "responses": {
          "200": {
            "description": "Array of publication summaries.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/PublicationSummary" }
                }
              }
            }
          },
          "400": {
            "description": "Invalid query parameters.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            }
          },
          "429": {
            "description": "Rate limit exceeded.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            },
            "headers": {
              "X-RateLimit-Reset": {
                "description": "Unix seconds until the limit resets.",
                "schema": { "type": "integer" }
              }
            }
          }
        }
      }
    },
    "/api/publications/{id}": {
      "get": {
        "summary": "Single publication",
        "description": "One published magazine or bulletin by its stable id (e.g. rooted-kids-oct-2026), including full weeks, days and interactive blocks.",
        "operationId": "getPublication",
        "tags": ["Magazines & Bulletins"],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Stable publication id (not a Mongo ObjectId).",
            "schema": { "type": "string", "pattern": "^[a-z0-9-]{1,80}$" }
          }
        ],
        "responses": {
          "200": {
            "description": "Full publication document.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Publication" }
              }
            }
          },
          "404": {
            "description": "Publication not found or not published.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            }
          },
          "429": {
            "description": "Rate limit exceeded.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            },
            "headers": {
              "X-RateLimit-Reset": {
                "schema": { "type": "integer" }
              }
            }
          }
        }
      }
    },
    "/api/reading-today": {
      "get": {
        "summary": "Today's reading target",
        "description": "Finds the day to open for a club's guided reading: exact date, then next upcoming, then the first day — returns a compact deep-link target.",
        "operationId": "getReadingToday",
        "tags": ["Magazines & Bulletins"],
        "parameters": [
          {
            "name": "tag",
            "in": "query",
            "required": false,
            "description": "Club tag (defaults to RELATE, e.g. ANCHOR, SPROUT-KIDS).",
            "schema": { "type": "string", "default": "RELATE" }
          },
          {
            "name": "date",
            "in": "query",
            "required": false,
            "description": "YYYY-MM-DD — the day to resolve (defaults to today).",
            "schema": { "type": "string", "format": "date" }
          }
        ],
        "responses": {
          "200": {
            "description": "Resolved target — or found:false when no guide matches.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ReadingTarget" }
              }
            }
          },
          "429": {
            "description": "Rate limit exceeded.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            },
            "headers": {
              "X-RateLimit-Reset": {
                "schema": { "type": "integer" }
              }
            }
          }
        }
      }
    },
    "/api/reading-plans": {
      "get": {
        "summary": "List reading plans",
        "description": "All reading plans with metadata — title, tagline, description, category, section, day count, gradient and cover image.",
        "operationId": "listReadingPlans",
        "tags": ["Reading Plans & Bible Study"],
        "responses": {
          "200": {
            "description": "Array of reading plan summaries.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/ReadingPlan" }
                }
              }
            }
          },
          "429": {
            "description": "Rate limit exceeded.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            },
            "headers": {
              "X-RateLimit-Reset": {
                "schema": { "type": "integer" }
              }
            }
          }
        }
      }
    },
    "/api/reading-plans/{slug}": {
      "get": {
        "summary": "Plan with sections",
        "description": "One reading plan plus its sections (book + chapter range), optional authored blocks, and a per-section quiz without answer keys.",
        "operationId": "getReadingPlan",
        "tags": ["Reading Plans & Bible Study"],
        "parameters": [
          {
            "name": "slug",
            "in": "path",
            "required": true,
            "description": "Reading plan slug (e.g. pentateuch-in-60-days).",
            "schema": { "type": "string", "pattern": "^[a-z0-9-]{1,80}$" }
          }
        ],
        "responses": {
          "200": {
            "description": "Plan metadata plus its sections.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/PlanDetail" }
              }
            }
          },
          "404": {
            "description": "Reading plan not found.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            }
          },
          "429": {
            "description": "Rate limit exceeded.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            },
            "headers": {
              "X-RateLimit-Reset": {
                "schema": { "type": "integer" }
              }
            }
          }
        }
      }
    },
    "/api/public-quiz/questions": {
      "get": {
        "summary": "Quiz question draw",
        "description": "A fresh shuffled question draw for a club — the hub season (Genesis 1–25). Answer keys are never sent; scoring happens on submit.",
        "operationId": "getQuizQuestions",
        "tags": ["Bible Quiz"],
        "parameters": [
          { "name": "club", "in": "query", "required": true, "description": "Club slug (sprout, surge, pulse, prime, anchor).", "schema": { "type": "string", "enum": ["sprout", "surge", "pulse", "prime", "anchor"] } },
          { "name": "count", "in": "query", "required": false, "description": "Question count, 5–15 (default 10).", "schema": { "type": "integer", "minimum": 5, "maximum": 15, "default": 10 } }
        ],
        "responses": {
          "200": { "description": "Club plus a question set without answers.", "content": { "application/json": { "schema": { "type": "object", "properties": { "club": { "type": "string" }, "count": { "type": "integer" }, "questions": { "type": "array", "items": { "$ref": "#/components/schemas/HubQuestion" } } } } } } },
          "400": { "description": "Invalid club.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
          "429": { "description": "Rate limit exceeded.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } }
        }
      }
    },
    "/api/public-quiz/attempts": {
      "post": {
        "summary": "Start or submit a quiz attempt",
        "description": "action=start persists a shuffled draw and returns it (no answers); action=submit scores server-side and returns the result. Rate limited per IP.",
        "operationId": "postQuizAttempt",
        "tags": ["Bible Quiz"],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/QuizAttemptRequest" } } }
        },
        "responses": {
          "200": { "description": "Started draw (action=start) or scored result (action=submit).", "content": { "application/json": { "schema": { "type": "object" } } } },
          "400": { "description": "Missing/unknown action or invalid inputs.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
          "404": { "description": "Attempt not found.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
          "429": { "description": "Rate limit exceeded.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } }
        }
      }
    },
    "/api/public-quiz/logs": {
      "get": {
        "summary": "Club board for the current round",
        "description": "One club's top-5 board and recent attempts for the current weekly round.",
        "operationId": "getQuizLogs",
        "tags": ["Bible Quiz"],
        "parameters": [
          { "name": "club", "in": "query", "required": true, "description": "Club slug.", "schema": { "type": "string", "enum": ["sprout", "surge", "pulse", "prime", "anchor"] } }
        ],
        "responses": {
          "200": { "description": "Club plus its board (top-5 rows + recent attempts).", "content": { "application/json": { "schema": { "type": "object" } } } },
          "400": { "description": "Invalid club.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
          "429": { "description": "Rate limit exceeded.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } }
        }
      }
    },
    "/api/public-quiz/overview": {
      "get": {
        "summary": "Season-wide top 5",
        "description": "The best scores across all five clubs this season.",
        "operationId": "getQuizOverview",
        "tags": ["Bible Quiz"],
        "responses": {
          "200": { "description": "Season overview with ranked rows.", "content": { "application/json": { "schema": { "type": "object" } } } },
          "429": { "description": "Rate limit exceeded.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } }
        }
      }
    },
    "/api/club-join": {
      "post": {
        "summary": "Submit a club-join application",
        "description": "Registers a person for a Relate sports club/team with their lifestyle and conduct declaration. Stores the application as pending_interview for the chaplaincy team. Rate limited per IP.",
        "operationId": "postClubJoin",
        "tags": ["Club Joining"],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ClubJoinRequest" } } }
        },
        "responses": {
          "201": { "description": "Application stored.", "content": { "application/json": { "schema": { "type": "object", "properties": { "id": { "type": "string", "description": "Application reference." }, "status": { "type": "string", "const": "pending_interview" }, "nextSteps": { "type": "string" } } } } } },
          "400": { "description": "Invalid or missing fields.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
          "429": { "description": "Rate limit exceeded.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Error": {
        "type": "object",
        "required": ["error"],
        "properties": {
          "error": { "type": "string" }
        }
      },
      "ClubJoinRequest": {
        "type": "object",
        "required": ["clubSlug", "name", "age", "phone", "conduct", "commitmentAccepted"],
        "properties": {
          "clubSlug": { "type": "string", "enum": ["sprout-kids", "sprout-tweens", "sprout-teens", "surge", "pulse"] },
          "clubName": { "type": "string" },
          "teamId": { "type": "string" },
          "teamName": { "type": "string" },
          "sport": { "type": "string", "enum": ["Football", "Netball", "Volleyball"] },
          "name": { "type": "string" },
          "age": { "type": "integer", "minimum": 6, "maximum": 99 },
          "gender": { "type": "string" },
          "phone": { "type": "string", "description": "Phone or WhatsApp number." },
          "area": { "type": "string" },
          "guardian": {
            "type": "object",
            "properties": {
              "name": { "type": "string" },
              "phone": { "type": "string" }
            },
            "description": "Required when age < 18."
          },
          "conduct": {
            "type": "object",
            "required": ["alcohol", "smoking", "drugs"],
            "properties": {
              "alcohol": { "type": "string", "enum": ["yes", "no"] },
              "smoking": { "type": "string", "enum": ["yes", "no"] },
              "drugs": { "type": "string", "enum": ["yes", "no"] },
              "sexualActivity": { "type": "string", "enum": ["yes", "no"], "description": "Required for surge and pulse clubs." }
            }
          },
          "commitmentAccepted": { "type": "boolean" }
        }
      },
      "Season": {
        "type": "object",
        "properties": {
          "label": { "type": "string" },
          "start": { "type": "string", "format": "date" },
          "end": { "type": "string", "format": "date" }
        }
      },
      "PublicationSummary": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "kind": { "type": "string", "enum": ["magazine", "bulletin"] },
          "series": { "type": "string" },
          "clubSlug": { "type": "string" },
          "title": { "type": "string" },
          "issue": { "type": "string" },
          "month": { "type": "string" },
          "year": { "type": "integer" },
          "cover": { "type": "string" },
          "summary": { "type": "string" },
          "tags": { "type": "array", "items": { "type": "string" } },
          "season": { "$ref": "#/components/schemas/Season" },
          "publishedAt": { "type": "string", "format": "date-time" }
        }
      },
      "Publication": {
        "type": "object",
        "description": "Full publication document — includes weeks/days and interactive blocks.",
        "allOf": [
          { "$ref": "#/components/schemas/PublicationSummary" }
        ],
        "properties": {
          "weeks": {
            "type": "array",
            "description": "Guided reading weeks.",
            "items": { "type": "object" }
          },
          "blocks": {
            "type": "array",
            "description": "Optional interactive content blocks.",
            "items": { "type": "object" }
          }
        }
      },
      "ReadingTarget": {
        "type": "object",
        "required": ["found"],
        "properties": {
          "found": { "type": "boolean" },
          "slug": { "type": "string" },
          "week": { "type": "integer" },
          "day": { "type": "integer" },
          "date": { "type": "string", "format": "date" }
        }
      },
      "ReadingPlan": {
        "type": "object",
        "properties": {
          "slug": { "type": "string" },
          "title": { "type": "string" },
          "tagline": { "type": "string" },
          "description": { "type": "string" },
          "category": { "type": "string" },
          "section": { "type": "string" },
          "days": { "type": "integer" },
          "gradient": { "type": "array", "items": { "type": "string" } },
          "image": { "type": "string" }
        }
      },
      "QuizQuestion": {
        "type": "object",
        "description": "Quiz question without the answer key.",
        "properties": {
          "id": { "type": "string" },
          "book": { "type": "string" },
          "chapter": { "type": "integer" },
          "question": { "type": "string" },
          "options": { "type": "array", "items": { "type": "string" } }
        }
      },
      "HubQuestion": {
        "type": "object",
        "description": "A public hub quiz question — no answer key.",
        "properties": {
          "id": { "type": "string" },
          "book": { "type": "string" },
          "bookLabel": { "type": "string" },
          "text": { "type": "string" },
          "options": { "type": "array", "items": { "type": "string" } }
        }
      },
      "QuizAttemptRequest": {
        "type": "object",
        "description": "Start or submit a public quiz attempt.",
        "properties": {
          "action": { "type": "string", "enum": ["start", "submit"] },
          "club": { "type": "string" },
          "name": { "type": "string" },
          "count": { "type": "integer" },
          "attemptId": { "type": "string" },
          "answers": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "questionId": { "type": "string" },
                "selected": { "type": "integer" }
              }
            }
          },
          "durationMs": { "type": "integer" }
        }
      },
      "PlanSection": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "planSlug": { "type": "string" },
          "title": { "type": "string" },
          "book": { "type": "string", "nullable": true },
          "startCh": { "type": "integer", "nullable": true },
          "endCh": { "type": "integer", "nullable": true },
          "verseText": { "type": "string" },
          "verseBy": { "type": "string" },
          "blocks": { "type": "array", "items": { "type": "object" } },
          "sort": { "type": "integer" },
          "quiz": { "type": "array", "items": { "$ref": "#/components/schemas/QuizQuestion" } }
        }
      },
      "PlanDetail": {
        "type": "object",
        "properties": {
          "plan": { "$ref": "#/components/schemas/ReadingPlan" },
          "sections": { "type": "array", "items": { "$ref": "#/components/schemas/PlanSection" } }
        }
      }
    }
  }
}